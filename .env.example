# Anthropic API key used by the Mozaik agents
ANTHROPIC_API_KEY=
# Model tiers (planner = strong, builder = cheaper)
MODEL_PLANNER=claude-opus-5-5
MODEL_BUILDER=claude-sonnet-5-5
# Local data directory (SQLite DB + uploaded files)
DATA_DIR=./data
PORT=3000
# Mozaik cloud telemetry uploads all agent events, including full study materials, to
# app.jigjoy.ai when MOZAIK_API_KEY / MOZAIK_PROJECT_KEY is set. The server refuses to
# start with them present unless you opt in with MOZAIK_CLOUD_ENABLED=true. Pairing
# (`npx @mozaik-ai/cloud-sdk pair`, writes ~/.mozaik/credentials.json) also only works
# with the opt-in, since the guard otherwise blocks the credentials lookup.
# MOZAIK_API_KEY authenticates; MOZAIK_PROJECT_ID is the project's handle shown in the
# cloud UI (informational). Both are shown on first sign-in at https://app.jigjoy.ai.
#MOZAIK_CLOUD_ENABLED=
#MOZAIK_API_KEY=
#MOZAIK_PROJECT_ID=
