# API key used by the Mozaik agents: an Anthropic key, or one issued by a gateway (see below)
ANTHROPIC_API_KEY=
# Optional. Leave empty for api.anthropic.com. Set to an Anthropic-compatible gateway, e.g. the
# hackathon credits gateway https://api.app.jigjoy.ai/gateway/anthropic (use the key it issues),
# to spend those credits. The gateway receives every prompt, including study materials.
ANTHROPIC_BASE_URL=
# Model tiers (planner = strong, builder = cheaper)
MODEL_PLANNER=claude-opus-5-5
MODEL_BUILDER=claude-sonnet-5-5
# Local data directory (SQLite DB + uploaded files)
DATA_DIR=./data
PORT=3000
# NEVER set MOZAIK_API_KEY / MOZAIK_PROJECT_KEY: the bundled Mozaik cloud SDK would upload
# all agent events, including full study materials, to app.jigjoy.ai.
