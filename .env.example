# Anthropic API key used by the Mozaik agents
ANTHROPIC_API_KEY=
# Model tiers (planner = strong, builder = cheaper)
MODEL_PLANNER=claude-opus-5-5
MODEL_BUILDER=claude-sonnet-5-5
# Local data directory (SQLite DB + uploaded files)
DATA_DIR=./data
PORT=3000
# NEVER set MOZAIK_API_KEY / MOZAIK_PROJECT_KEY: the bundled Mozaik cloud SDK would upload
# all agent events, including full study materials, to app.jigjoy.ai.
